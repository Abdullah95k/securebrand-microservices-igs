/bin/
# go build ./cmd/<name> in the repository root
/igs-spike
/igsctl
/fakeig
*.test
*.out
spike-results.jsonl
/coverage*
.env
__pycache__/
# Phase 0: credentials, your profile list and results stay local. Everything
# in phase0/ is ignored except the kit's own files, so editor swap files and
# backups of proxies.yaml (which hold credentials) can't be committed either.
/phase0/*
!/phase0/proxies.example.yaml
!/phase0/ig-profiles.example.txt
!/phase0/igs-dryrun.sh
!/phase0/igs-dryrun-profiles.txt
# igs: the owner's HAR recordings, raw Instagram responses and probe output
# stay local (docs/instagram/build-brief.md §7). Keep them under .local/.
/.local/
